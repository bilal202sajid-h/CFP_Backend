DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chiniot_furniture
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS: use * to allow all origins (required for Vercel admin + storefront)
CORS_ALLOW_ORIGINS=*

# Cloudinary (use the explicit values below as the single source of truth)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=chiniot-furniture/products